# ---- AdamN NMS runtime options (optional) ----
# Web address: 127.0.0.1 = this computer only, 0.0.0.0 = also visible on your local network
HOST=127.0.0.1
PORT=4000

# Where AdamN keeps its own small config + backups + the default HDANA data file.
# Leave empty to use ./storage inside the project folder.
ADAMN_HOME=

# Open the default browser automatically on start (1 = yes)
ADAMN_OPEN=0
